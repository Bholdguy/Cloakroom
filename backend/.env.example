# Employer treasury account — this process holds keys. Do not use for the
# employee-facing wallet UI (that path is the STRK20 starter kit).

CLOAKROOM_NETWORK=mainnet
CLOAKROOM_RPC_URL=https://rpc.starknet.public.blastapi.io

# Optional override. Default: config/deployments.json for CLOAKROOM_NETWORK.
# Sepolia pool: 0x0254a6b2997ef52e9f830ce1f543f6b29768295e8d17e2267d672c552cfe0d91
# Mainnet pool: 0x040337b1af3c663e86e333bab5a4b28da8d4652a15a69beee2b677776ffe812a
CLOAKROOM_POOL_ADDRESS=0x040337b1af3c663e86e333bab5a4b28da8d4652a15a69beee2b677776ffe812a

# STRK on Starknet (privacy pool STRK_TOKEN_ADDRESS). Override for USDC payroll.
# CLOAKROOM_TOKEN_ADDRESS=0x04718f5a0fc34cc1af16a1cdee98ffb20c31f5cd61d6ab07201858f4287c938d

CLOAKROOM_ACCOUNT_ADDRESS=0x
CLOAKROOM_PRIVATE_KEY=0x
CLOAKROOM_VIEWING_KEY=0x

# Required for the raw SDK route. Day-0 docs: mainnet proving URL is not
# published there; get it from the private builders group. Do not guess.
CLOAKROOM_PROVING_SERVICE_URL=

# Required for Sepolia/mainnet. The client uses IndexerDiscoveryProvider when
# set. Without it the backend will throw at startup (ContractDiscoveryProvider
# is a testing-only fallback removed from the production client).
# CLOAKROOM_DISCOVERY_URL=

# Deployed PayrollAnonymizer. Required for lock / claim / session.
# TODO: no official Cloakroom anonymizer address in the starter kit or scarb output.
# CLOAKROOM_ANONYMIZER_ADDRESS=0x

# Required for Lock. TODO: no default session-key id in the starter kit or scarb output.
# CLOAKROOM_SESSION_KEY_ID=

# Sequencer acceptance window from the SDK README (default 10).
# CLOAKROOM_PROVING_DEPTH=10
# CLOAKROOM_BLOCK_TIME_MS=2000

{
  "name": "cloakroom-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Employer-side Cloakroom client: official Privacy SDK, CSV payroll ingest, and vesting InvokeExternal. Not the employee wallet UI.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "preinstall": "node scripts/clone-official-sdk.mjs",
    "build": "tsc",
    "cli": "tsx src/cli.ts",
    "payroll": "tsx src/cli.ts payroll",
    "lock": "tsx src/cli.ts lock",
    "claim": "tsx src/cli.ts claim",
    "register": "tsx src/cli.ts register",
    "session": "tsx src/cli.ts session",
    "balance": "tsx src/cli.ts balance"
  },
  "dependencies": {
    "@starkware-libs/starknet-privacy-sdk": "file:vendor/starknet-privacy/sdk",
    "csv-parse": "*",
    "dotenv": "*",
    "starknet": "10.4.0"
  },
  "devDependencies": {
    "@types/node": "24.10.2",
    "starknet-devnet": "^0.8.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  }
}
